# ==============================================================================
# Production-Grade Supabase Architecture - Environment Configuration
# ==============================================================================

# Supabase Local or Cloud Project Endpoint
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL Direct Connection & Supavisor Connection Pooler
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_POOLER_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?pgbouncer=true

# Storage Settings
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=global
STORAGE_DEFAULT_BUCKET=enterprise-vaults
MAX_CHUNK_SIZE_BYTES=5242880 # 5MB chunk slicing default

# Observability & Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Load Testing Parameters
K6_VUS=100
K6_DURATION=30s
K6_TARGET_RPS=2000
