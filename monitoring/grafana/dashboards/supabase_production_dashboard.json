      "id": 6,
      "title": "Storage Ingest Bandwidth",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(supabase_storage_bytes_uploaded_total[1m])", "legendFormat": "Bytes Uploaded/s" }
